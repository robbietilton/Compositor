    "Zoom in (⌘+), now %@. At 100%% each pixel of the JPEG is one pixel of the screen, as on the canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 (⌘+)，当前 %@。在 100%% 时，JPEG 的每个像素对应屏幕上的一个像素，与画布相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 (⌘+)，當前 %@。在 100%% 時，JPEG 的每個像素對應螢幕上的一個像素，與畫布相同"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン (⌘+)、現在 %@。100%% では、JPEG の 1 ピクセルが画面の 1 ピクセルになり、カンバスと同じです"
          }
        }
      }
    },
