    },
    "Noise Reduction": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雜訊減少"
          }
        }
      }
    },
    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉會保留影像原狀。引導模式會依你在影像上繪製的線條進行拉直。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定"
          }
        }
      }
    },
    "Only print dimensions and resolution change. Pixels stay unchanged.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會改變列印尺寸與解析度。像素維持不變。"
          }
        }
      }
    },
