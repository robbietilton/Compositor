        }
      }
    },
    "Click the original layer to set %@. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下原始圖層以設定 %@。再按一次吸管即可停止。"
