    "Select layer mask; Option-click to view it alone; Shift-click to enable/disable; Cmd-click to select its black areas (Cmd-Shift adds, Cmd-Option subtracts)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择图层蒙版；按住 Option 单击可单独查看；按住 Shift 单击可启用或停用；按住 Command 单击可选择其黑色区域（Command-Shift 添加，Command-Option 减去）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇圖層遮色片；按住 Option 單擊可單獨檢視；按住 Shift 單擊可啟用或停用；按住 Command 單擊可選擇其黑色區域（Command-Shift 加入，Command-Option 減去）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクを選択。Option キーを押しながらクリックで単独表示。Shift キーを押しながらクリックで有効/無効。Command キーを押しながらクリックで黒い部分を選択（Command-Shift で追加、Command-Option で除外）"
          }
        }
      }
    },
    "Select layer; Cmd-click to select its pixels (Cmd-Shift adds, Cmd-Option subtracts)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择图层；按住 Command 单击可选择其像素（Command-Shift 添加，Command-Option 减去）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇圖層；按住 Command 單擊可選擇其像素（Command-Shift 加入，Command-Option 減去）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーを選択。Command キーを押しながらクリックでピクセルを選択（Command-Shift で追加、Command-Option で除外）"
          }
        }
      }
    },
    "Select layers by clicking the canvas. Hold Command to turn it the other way while you click.": {
