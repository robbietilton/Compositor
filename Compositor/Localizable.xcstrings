    "A little stronger than Version 1. The sliders below still fall well short of the current look.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比版本 1 稍强。下方滑块仍远达不到当前外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比版本 1 稍強。下方滑塊仍遠達不到當前外觀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 1 より少し強いです。下のスライダーは、現在の見た目にはまだ大きく届きません。"
          }
        }
      }
    },
    "A subdivision every %@ pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 %@ 像素一条子网格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 %@ 像素一條子網格。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ピクセルごとに 1 分割。"
          }
        }
      }
    },
