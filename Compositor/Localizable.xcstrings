    "Zoom percentage (0.1–3200%). Press Return to apply.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放百分比（0.1–3200%）。按回车应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放百分比（0.1–3200%）。按回車應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームの割合（0.1–3200%）。Return で適用。"
          }
