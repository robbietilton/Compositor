    "Add layer mask (Option-click for a black mask)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图层蒙版（按住 Option 单击得到黑色蒙版）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
