    "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线性直方图，垂直方向自动缩放。高峰可能超出图表；0 到 255 的所有影调仍包括在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "線性直方圖，垂直方向自動縮放。高峰可能超出圖表；0 到 255 的所有影調仍包括在內。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "垂直方向は自動スケールの線形ヒストグラム。高い山はグラフの外まで伸びることがあります。0 から 255 のすべてのトーンは含まれたままです。"
          }
        }
      }
    },
