    "Click a pixel that should be neutral.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下應為中性色的像素。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下紫色或綠色邊緣，以設定其色相範圍。"
          }
        }
      }
    },
    "Click a shortcut, then press its new key combination. Changes apply when you save.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下快速鍵，然後按下新的按鍵組合。儲存時才會套用變更。"
          }
        }
      }
    },
    "Click the canvas to sample": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下畫布以進行取色"
          }
        }
      }
    },
    "Click the fringe on the layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下圖層上的邊緣。再按一次吸管即可停止。"
          }
        }
      }
    },
    "Click the image to pick the color to select.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下影像以挑選要選取的顏色。"
