    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边使用 1–%@ 像素，最多 %lld 百万像素，分辨率为 1–9,600 像素/英寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊使用 1–%@ 像素，最多 %lld 百萬像素，解析度為 1–9,600 像素/英寸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各辺は 1–%@ ピクセル、最大 %lld メガピクセル、解像度は 1–9,600 ピクセル/インチ。"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间距为 %1$lld–%2$@ 像素，细分数为 %3$lld–%4$lld，且不超过网格线之间的像素数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網格線間距為 %1$lld–%2$@ 像素，細分數為 %3$lld–%4$lld，且不超過網格線之間的像素數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッド線は %1$lld–%2$@ ピクセル間隔、分割数は %3$lld–%4$lld。グリッド線の間のピクセル数を超えないこと。"
          }
        }
      }
    },
    "Vector shape was rasterized to pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "矢量形状已栅格化为像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向量形狀已柵格化為像素。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベクトルシェイプをピクセルにラスタライズしました。"
          }
        }
      }
    },
