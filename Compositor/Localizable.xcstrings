    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片中拖移一种颜色。邻近的颜色族会一起移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
