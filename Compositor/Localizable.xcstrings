    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹，本身没有像素。请在其中的图层上绘制，或在文件夹蒙版上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是資料夾，本身沒有像素。請在其中的圖層上繪製，或在資料夾遮色片上繪製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はフォルダーで、自身のピクセルがありません。中のレイヤーか、フォルダーのマスクにペイントしてください。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可绘制的像素。请改为在其蒙版上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是調整圖層，沒有可繪製的像素。請改為在其遮色片上繪製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は調整レイヤーで、ペイントできるピクセルがありません。代わりにマスクへペイントしてください。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏，或位于隐藏的文件夹中。显示之后才能绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隱藏，或位於隱藏的資料夾中。顯示之後才能繪製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は隠れているか、隠れているフォルダーの中にあります。表示してからペイントしてください。"
          }
        }
      }
    },
    "“%@” was changed on disk.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘上的“%@”已被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟上的“%@”已被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上の「%@」が変更されました。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
