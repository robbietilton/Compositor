    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值拉直向外弯的线（桶形）；负值拉直向内弯的线（枕形）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值拉直向外彎的線（桶形）；負值拉直向內彎的線（枕形）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値は外側へふくらむ線（樽型）をまっすぐにし、負の値は内側へくびれる線（糸巻き型）をまっすぐにします。"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值把检测到的蒙版向内收紧；负值向外扩展"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值把檢測到的遮色片向內收緊；負值向外擴充套件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値は検出したマスクを内側へ締め、負の値は外側へ広げます"
          }
        }
      }
    },
    "Preserve Luminosity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留明度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留明度"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝度を保持"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少颜色杂色时保留彩色边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在減少顏色雜色時保留彩色邊緣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーノイズを減らしながら、色の付いたエッジを残します。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少明亮度杂色时保留细微纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在減少明亮度雜色時保留細微紋理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝度ノイズを減らしながら、細かいテクスチャを残します。"
          }
        }
      }
    },
