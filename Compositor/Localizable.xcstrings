          "stringUnit": {
            "state": "translated",
            "value": "画像の中の色をドラッグ。近い色系統も一緒に動きます。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移一个点。单击以添加点。双击一个点可将其移去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移一個點。單擊以加入點。雙擊一個點可將其移去。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントをドラッグ。クリックで追加。ポイントをダブルクリックで削除。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖出矩形 · Shift 添加 · Option 减去 · 拖移中再按 Shift 得到正方形 · 在内部拖移可移动 · ⌘ 拖移移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖出矩形 · Shift 加入 · Option 減去 · 拖移中再按 Shift 得到正方形 · 在內部拖移可移動 · ⌘ 拖移移動像素 · Delete 清除 · ⌘D 取消選擇"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長方形をドラッグ · Shift で追加 · Option で除外 · ドラッグ中にもう一度 Shift で正方形 · 内側をドラッグで移動 · ⌘ ドラッグでピクセルを移動 · Delete で消去 · ⌘D で選択解除"
          }
        }
      }
    },
    "Drag a text box · Click text to edit · Drag box handles to resize · ⌘Return finish · Escape cancel": {
