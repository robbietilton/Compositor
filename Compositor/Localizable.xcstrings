    "Smudge and Liquify work on a layer's pixels, not its mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涂抹和液化作用于图层像素，而不是蒙版。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "塗抹和液化作用於圖層像素，而不是遮色片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指先とゆがみはレイヤーのピクセルに働き、マスクには働きません。"
          }
        }
      }
    },
