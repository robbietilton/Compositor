          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选区细节过多，无法生成轮廓。请调整容差或启用“连续”。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %lld megapixels.": {
      "extractionState": "manual",
      "localizations": {
