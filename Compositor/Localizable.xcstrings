    "%@ is assigned to both %@ and %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同时指定给了“%@”和“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同時指定給了“%@”和“%@”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は「%@」と「%@」の両方に割り当てられています。"
          }
        }
      }
    },
    "%@ is reserved by macOS.": {
      "localizations": {
