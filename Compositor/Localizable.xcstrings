    "Show the transform box and handles (⌘H). When hidden, drag anywhere to move the layer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示变换框和控制点 (⌘H)。隐藏时，在任意位置拖移可移动图层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示變換框和控制點 (⌘H)。隱藏時，在任意位置拖移可移動圖層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変形ボックスとハンドルを表示 (⌘H)。隠れているときは、どこをドラッグしてもレイヤーが動きます。"
          }
