    "Smooth selection edges; turn off for hard pixel edges": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑选区边缘；关闭则得到硬像素边缘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑選區邊緣；關閉則得到硬像素邊緣"
          }
        },
        "ja": {
          "stringUnit": {
