      }
    },
    "Drag left or right to adjust blacks, shadows, exposure, highlights, or whites. The starting region stays selected. Hold Option to see clipping. Control-click to show the vectorscope.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Drag left or right to adjust blacks, shadows, exposure, highlights, or whites. The starting region stays selected. Hold Option to see clipping. Control-click to show the vectorscope." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "左右拖动以调整黑色、阴影、曝光、高光或白色。一次拖动始终调整起点所在分区。按住 Option 查看溢出，按住 Control 点按可显示矢量示波器。" } }
      }
    },
