          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个像素的误差扩散到相邻像素的程度；较低数值会产生更平坦的区域"
          }
        }
      }
    },
    "How much of the gap a bright line fills; dimmer parts draw it thinner": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮线填充间隙的程度；较暗部分会绘制得更细"
