      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亮部裁切指示器"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亮部優先可保護亮邊緣。色彩優先還會減少色彩。繪圖覆蓋則均勻覆蓋邊緣。"
          }
        }
      }
    },
    "Highlights": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亮部"
          }
        }
      }
