      }
    },
    "How far in brightness the adjustment reaches.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在亮度上延伸的范围。"
          }
        }
      }
    },
