    },
    "Shift-click adds a color, Option-click takes one away.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 单击添加一种颜色，Option 单击去掉一种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
