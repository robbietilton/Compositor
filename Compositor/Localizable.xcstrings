    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烘焙会把当前蒙版外观保留在依赖图层的像素里。移去链接会露出它们的像素。两种选择都可以撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "烘焙會把當前遮色片外觀保留在依賴圖層的像素裡。移去連結會露出它們的像素。兩種選擇都可以還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベイクは、今のマスクされた見え方を依存レイヤーのピクセルに残します。リンクを外すと、それらのピクセルが見えます。どちらも取り消せます。"
          }
        }
      }
    },
