        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Option 键点按设置取样源 · 拖移以仿制 · [ ] 调整大小 · Shift-[ ] 调整硬度 · 1–0 调整不透明度 · 空格键平移"
          }
        }
      }
    },
