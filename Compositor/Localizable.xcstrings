        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投影"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投影"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投影"
          }
        }
      }
    },
    "Protect bright areas near the edge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护边缘附近的亮部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護邊緣附近的亮部"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端に近い明るい部分を保護"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用暗角晕影时保护明亮像素。高光优先会用到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用暗角暈影時保護明亮像素。高光優先會用到它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗いビネットを掛けるとき、明るいピクセルを保護します。ハイライト優先が使います。"
          }
        }
      }
    },
    "Proximity Match": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邻近匹配"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鄰近匹配"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近傍で合わせる"
          }
        }
      }
    },
    "Pull the mask onto the image's own edges, which recovers hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把蒙版贴到图像自身的边缘，以恢复头发和毛发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把遮色片貼到影像自身的邊緣，以恢復頭髮和毛髮"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクを画像自身のエッジに引き寄せ、髪や毛を取り戻す"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把红边和蓝边向中心拉开，以减少色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把紅邊和藍邊向中心拉開，以減少色邊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤と青のフリンジを中心へ引き離して、色の縁を減らします。"
          }
        }
      }
    },
