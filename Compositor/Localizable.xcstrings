        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次滤镜：%@"
          }
        }
      }
    },
    "New canvas (⌘N)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建画布（⌘N）"
          }
        }
      }
    },
    "Fit canvas in window (⌘0)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合窗口（⌘0）"
          }
        }
      }
    },
    "Actual pixels (⌘1)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际像素（⌘1）"
          }
        }
      }
    },
    "Zoom in (⌘+)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大（⌘+）"
          }
        }
      }
    },
    "Zoom out (⌘−)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小（⌘−）"
          }
        }
      }
    },
    "Drag to resize the panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖拽以调整面板大小"
          }
        }
      }
    },
    "Paint with the foreground color (B), or erase pixels away (E)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用前景色绘画（B），或擦除像素（E）"
          }
        }
      }
    },
    "Liquify pushes pixels · Blur softens · Smudge drags color along": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "液化推动像素 · 模糊柔化 · 涂抹拖拽颜色"
          }
        }
      }
    },
    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让源随画笔在笔触间移动；关闭时每笔都从源点开始"
          }
        }
      }
    },
    "Copy from the active layer only, or from every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从当前图层复制，或从所有可见图层复制"
          }
        }
      }
    },
    "Press 1–9 for 10–90%, 0 for 100%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 1–9 设置 10–90%，按 0 设置 100%"
          }
        }
      }
    },
    "How far the blur softens, in pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊柔化程度，以像素为单位"
          }
        }
      }
    },
    "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画笔沿此长度的线跟随指针，手抖也能画出平滑线条"
          }
        }
      }
    },
    "Option-click to set the source": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Option 点击设置源"
          }
        }
      }
    },
    "Swap foreground and background (X)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换前景色和背景色（X）"
          }
        }
      }
    },
    "Default colors (D)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认颜色（D）"
          }
        }
      }
    },
    "Press Tab to switch between Wand and Object": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Tab 在魔棒和对象之间切换"
          }
        }
      }
    },
    "Press M to switch between Rectangle and Ellipse": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 M 在矩形和椭圆之间切换"
          }
        }
      }
    },
    "Press L to switch between Freehand and Polygonal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 L 在自由套索和多边形套索之间切换"
          }
        }
      }
    },
    "Hold Shift to add or Option to subtract for one outline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 添加或 Option 减去一个轮廓"
          }
        }
      }
    },
    "Fade the edge of the selection by this many pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此像素数羽化选区边缘"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道（0–255）与点击颜色可相差多少仍被选中"
          }
        }
      }
    },
    "Match the clicked pixel, or the average of the pixels around it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配点击的像素，或其周围像素的平均值"
          }
        }
      }
    },
    "Read colors from the active layer only, or from every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从当前图层读取颜色，或从所有可见图层读取"
          }
        }
      }
    },
    "Select only similar pixels connected to the one you click; off selects them everywhere": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅选择与点击处相连的相似像素；关闭则选择所有相似像素"
          }
        }
      }
    },
    "Analyze the active layer only, or every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅分析当前图层，或分析所有可见图层"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值向内收紧检测到的蒙版；负值向外扩展"
          }
        }
      }
    },
    "How far a color may be from the picked ones and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色与所选取色可相差多少仍被选中"
          }
        }
      }
    },
    "Select everything except those colors, such as all but a green screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择除这些颜色以外的所有内容，例如绿幕之外的一切"
          }
        }
      }
    },
    "Choose the vignette color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择暗角颜色"
          }
        }
      }
    },
    "Blend the chosen color into the edges while keeping the center unchanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选颜色混合到边缘，同时保持中心不变"
          }
        }
      }
    },
    "Protect bright areas near the edge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护边缘附近的明亮区域"
          }
        }
      }
    },
    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个抖动像素横跨这么多像素，营造复古粗颗粒屏幕效果"
          }
        }
      }
    },
    "The height of each line of characters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行字符的高度"
          }
        }
      }
    },
    "How far apart the screen's lines are": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕线条之间的间距"
          }
        }
      }
    },
    "Light blooming around the lines, like a CRT's phosphors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线条周围的光晕，像 CRT 荧光粉一样"
          }
        }
      }
    },
    "Break the lines into glowing beads": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将线条分解为发光珠点"
          }
        }
      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让线条沿屏幕横向抖动，像 CRT 失步一样"
          }
        }
      }
    },
    "The characters to draw with, in any order: each spot gets the one whose ink best matches its tone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于绘制的字符，任意顺序：每个位置用墨色最匹配其色调的字符"
          }
        }
      }
    },
    "Tones per channel: 2 is pure black and white": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每通道色调：2 为纯黑白"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个像素的误差向邻居扩散多少。越少则区域越平坦"
          }
        }
      }
    },
    "More ink (darker) or less before dithering": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抖动前增加（更深）或减少墨量"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个粗颗粒像素绘制为实心方块，或像点阵屏一样的圆点"
          }
        }
      }
    },
    "Draw the marks for the light tones on the dark color, like a glowing screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色上绘制浅色调标记，像发光的屏幕"
          }
        }
      }
    },
    "Color the result while keeping its tones, for a sepia or a cyanotype": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在保留色调的同时为结果着色，实现棕褐色或蓝晒效果"
          }
        }
      }
    },
    "Put each pixel's brightness back afterwards, so only the color moves": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后恢复每个像素的亮度，只改变颜色"
          }
        }
      }
    },
    "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本模式较快；高级模式根据图层自身细节细化蒙版，适合毛发"
          }
        }
      }
    },
    "Pull the mask onto the image's own edges, which recovers hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蒙版贴合到图像自身边缘，恢复毛发"
          }
        }
      }
    },
    "Clear the haze that leaves background showing through thin areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除使背景透过薄弱区域显现的雾状残留"
          }
        }
      }
    },
    "Shrink the mask to drop the rim of background color around the subject, or grow it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收缩蒙版以去除主体周围的背景色边缘，或扩展它"
          }
        }
      }
    },
    "Fill the selection using surrounding pixels from this layer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该图层周围的像素填充选区。"
          }
        }
      }
    },
    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用图层蒙版隐藏背景，保留前景主体。像素仍在，随时可重新绘制背景。"
          }
        }
      }
    },
    "Linear runs along the line; Radial spreads out from the start point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线性沿直线分布；径向从起点向外扩散"
          }
        }
      }
    },
    "Round the rectangle's corners by this many pixels; 0 keeps them square": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此像素数圆角矩形的角；0 保持直角"
          }
        }
      }
    },
    "Shapes fill with the foreground color; click to change it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状以前景色填充；点击可更改"
          }
        }
      }
    },
    "Shift-U (or Tab) steps through Rectangle, Ellipse and Line": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-U（或 Tab）在矩形、椭圆和直线间切换"
          }
        }
      }
    },
    "Lock aspect ratio. Hold Shift while dragging a handle to turn it the other way.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定宽高比。拖动控制柄时按住 Shift 可反向切换。"
          }
        }
      }
    },
    "Scale width and height together, about the center": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕中心同时缩放宽度和高度"
          }
        }
      }
    },
    "Select layers by clicking the canvas. Hold Command to turn it the other way while you click.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过点击画布选择图层。点击时按住 Command 可反向切换。"
          }
        }
      }
    },
    "Show the transform box and handles (⌘H). When hidden, drag anywhere to move the layer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示变换框和控制柄（⌘H）。隐藏时可拖拽任意位置移动图层。"
          }
        }
      }
    },
    "Line height, baseline to baseline. Empty or 0 is Auto: 120% of the font size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行高，基线到基线。留空或 0 为自动：字体大小的 120%。"
          }
        }
      }
    },
    "Click a shortcut, then press its new key combination. Changes apply when you save.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一个快捷键，然后按下新的按键组合。存储后更改生效。"
          }
        }
      }
    },
    "Contextual keys & mouse gestures": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文按键与鼠标手势"
          }
        }
      }
    },
    "Text fields keep standard macOS editing keys. Dialogs share the Apply/Cancel assignments above. Numeric fields use Up/Down, with Shift for larger steps. Standard macOS commands include ⌘Q to quit and ⌃⌘F for full screen. The shortcut editor itself always uses Return to save and Esc to cancel when not recording.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本字段保留标准 macOS 编辑按键。对话框共享上述应用/取消分配。数字字段使用上/下键，Shift 用于更大幅度。标准 macOS 命令包括 ⌘Q 退出和 ⌃⌘F 全屏。快捷键编辑器本身始终使用 Return 保存，Esc 在不录制时取消。"
          }
        }
      }
    },
    "Option temporarily selects the eyedropper in painting tools. Shift constrains shapes/movement or adds to a selection; Option subtracts from selections or draws from center. Command-drag moves selected pixels; Command-Option-drag copies them. Option-drag duplicates layers/folders/effects; Option-click at a layer boundary toggles clipping. Command-click a thumbnail loads its selection. Control bypasses snapping. Right-drag adjusts brush size. Modifier-and-mouse gestures are fixed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Option 在绘画工具中临时选择吸管。Shift 约束形状/移动或添加到选区；Option 从选区减去或从中心绘制。Command 拖拽移动选中像素；Command-Option 拖拽复制它们。Option 拖拽复制图层/文件夹/效果；在图层边界 Option 点击切换剪贴。Command 点击缩略图载入其选区。Control 绕过吸附。右键拖拽调整画笔大小。修饰键与鼠标手势是固定的。"
          }
        }
      }
    },
    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数模式提升色调区域。点模式在曲线上放置锚点。"
          }
        }
      }
    },
    "RGB changes brightness. Red, green, and blue also shift the color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 改变亮度。红、绿、蓝也会偏移颜色。"
          }
        }
      }
    },
    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL 列出所有颜色。颜色模式编辑一个色系。点颜色调整你选取的颜色。"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相偏移颜色，饱和度改变强度，明度改变亮度。"
          }
        }
      }
    },
    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三向显示阴影、中间调和高光。其他选项显示一个色轮。"
          }
        }
      }
    },
    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖拽图片中的颜色。附近的色系一起移动。"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖拽。角度设置色相，距离设置饱和度。"
          }
        }
      }
    },
    "Dims the picture outside this color's range. It is not kept when you press OK.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将该颜色范围之外的图片变暗。按确定后不会保留。"
          }
        }
      }
    },
    "Click the picture to save a color. Up to eight colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图片保存颜色。最多八种颜色。"
          }
        }
      }
    },
    "Select this picked color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此已取颜色。"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖拽设置色相和饱和度。双击重置此色轮。"
          }
        }
      }
    },
    "Input and output of the selected curve point.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选曲线点的输入与输出。"
          }
        }
      }
    },
    "Replaces this curve with a straight line or a contrast curve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用直线或对比度曲线替换此曲线。"
          }
        }
      }
    },
    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动平衡平均颜色。自定义跟随色温和色调。"
          }
        }
      }
    },
    "Click a pixel that should be neutral.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击应为中性色的像素。"
          }
        }
      }
    },
    "Click the original layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击原始图层。再次点击吸管停止。"
          }
        }
      }
    },
    "Diffusion is soft and wide, Bloom is tighter, and Halation is a red fringe.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩散柔和而宽广，辉光更集中，光晕呈红色边缘。"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先保护明亮边缘。颜色优先同时降低颜色。绘画叠加均匀覆盖边缘。"
          }
        }
      }
    },
    "Red, green, and blue of the pixel under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针下方像素的红、绿、蓝分量。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击紫色或绿色边缘以设置其色相范围。"
          }
        }
      }
    },
    "Click the fringe on the layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图层上的边缘。再次点击吸管停止。"
          }
        }
      }
    },
    "Start of the hue range, in degrees.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相范围的起点，以度为单位。"
          }
        }
      }
    },
    "End of the hue range, in degrees.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相范围的终点，以度为单位。"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红蓝边缘向中心拉开以减少彩色镶边。"
          }
        }
      }
    },
    "Applies generic profile strength when camera metadata is not available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机元数据不可用时应用通用配置文件强度。"
          }
        }
      }
    },
    "No lens metadata on this layer. Profile sliders set generic correction strength.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该图层没有镜头元数据。配置文件滑块设置通用校正强度。"
          }
        }
      }
    },
    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭保持图片原样。引导模式根据你在图片上绘制的线条进行拉直。"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览上绘制两条或多条应水平或垂直的线条。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖拽放置参考线。至少绘制两条线。"
          }
        }
      }
    },
    "Remove every guide line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除所有参考线。"
          }
        }
      }
    },
    "Perspective allows stronger keystone. Rectilinear keeps the warp gentler.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透视允许更强的梯形校正。直线模式保持更平缓的变形。"
          }
        }
      }
    },
    "Crops empty edges after the transform and fits the result back into the frame.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变换后裁剪空白边缘，并将结果重新适配到画面。"
          }
        }
      }
    },
    "Chooses how strongly the calibration sliders below are applied. Version 6 is the current default.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择下方校准滑块的强度。版本 6 为当前默认。"
          }
        }
      }
    },
    "Click to add a point. Drag to adjust.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击添加点。拖拽调整。"
          }
        }
      }
    },
    "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带自动垂直缩放的线性直方图。高峰可能超出图表；所有 0 到 255 的色调均包含在内。"
          }
        }
      }
    },
    "Targeted adjustment: drag on the image to change that color's saturation, or its hue with Command held": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标调整：在图像上拖拽改变该颜色的饱和度，或按住 Command 改变其色相"
          }
        }
      }
    },
    "Show the whole image (⌘0)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示整个图像（⌘0）"
          }
        }
      }
    },
    "Zoom in (⌘+), now %@. At 100% each pixel of the JPEG is one pixel of the screen, as on the canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大（⌘+），当前 %@。在 100% 时 JPEG 的每个像素对应屏幕一个像素，与画布上相同"
          }
        }
      }
    },
    "Zoom out (⌘−), now %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小（⌘−），当前 %@"
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖拽或滚动以移动；双击在适合与 100% 之间切换"
          }
        }
      }
    },
    "Color for the added canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加画布的颜色"
          }
        }
      }
    },
    "Color that fills transparent areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填充透明区域的颜色"
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此点固定。图稿不缩放；被裁剪的内容保留在画布之外。"
          }
        }
      }
    },
    "Final dimensions must be 1–%@ pixels per side.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终每边尺寸必须在 1–%@ 像素之间。"
          }
        }
      }
    },
    "%@ uncompressed RGBA canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未压缩 RGBA 画布"
          }
        }
      }
    },
    "Resizes layer pixels and applies existing transforms. Undo restores the originals.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图层像素并应用现有变换。撤销可恢复原始内容。"
          }
        }
      }
    },
    "Only print dimensions and resolution change. Pixels stay unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅打印尺寸和分辨率发生变化。像素保持不变。"
          }
        }
      }
    },
    "Choose a custom grid color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择自定义网格颜色"
          }
        }
      }
    },
    "Preset sizes for screens and common formats": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕和常用格式的预设尺寸"
          }
        }
      }
    },
    "Drop to open in a new canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放以在新画布中打开"
          }
        }
      }
    },
    "Zoom percentage (0.1–3200%). Press Return to apply.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放百分比（0.1–3200%）。按 Return 应用。"
          }
        }
      }
    },
    "sRGB · Transparent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sRGB · 透明"
          }
        }
      }
    },
    "Click to select; double-click to edit; Option-drag to copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击以选择；双击以编辑；Option 拖拽以复制"
          }
        }
      }
    },
    "Clipping mask based on %@. Option-click the bottom of its row to release.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 %@ 的剪贴蒙版。Option 点击其行底可释放。"
          }
        }
      }
    },
    "New blank layer (⇧⌘N)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建空白图层（⇧⌘N）"
          }
        }
      }
    },
    "Group selected layers (⌘G)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编组所选图层（⌘G）"
          }
        }
      }
    },
    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值拉直向外凸出的线条（桶形）；负值拉直向内凹的线条（枕形）。"
          }
        }
      }
    },
    "Select %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 %@"
          }
        }
      }
    },
    "Show %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 %@"
          }
        }
      }
    },
    "Hide %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 %@"
          }
        }
      }
    },
    "Levels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色阶"
          }
        }
