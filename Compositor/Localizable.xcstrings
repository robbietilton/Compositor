    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个仿色像素占这么多像素宽，得到粗颗粒的旧屏幕效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓每個仿色像素佔這麼多像素寬，得到粗顆粒的舊螢幕效果"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディザした各ピクセルをこのピクセル数の幅にする。古い画面のような粗い見た目"
          }
        }
      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让线条沿屏幕向下左右摆动，像 CRT 失步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓線條沿螢幕向下左右擺動，像 CRT 失步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線を画面の下へ向かって左右に揺らす。同期の外れた CRT のように"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加大或减小亮部与暗部的差别，主要作用于中间调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加大或減小亮部與暗部的差別，主要作用於中間調。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るいトーンと暗いトーンの差を大きくするか小さくします。主に中間付近です。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颜色平滑更柔和或更紧致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使顏色平滑更柔和或更緊緻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーの平滑化を柔らかくするか、きつくします。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更粗或更细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使顆粒更粗或更細。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "粒子を粗くするか細かくします。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更平滑或更不均匀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使顆粒更平滑或更不均勻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "粒子を滑らかにするか、むらを強くします。"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使拾取的颜色更亮或更暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使拾取的顏色更亮或更暗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "採取したカラーを明るくするか暗くします。"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使拾取的颜色更浓或更淡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使拾取的顏色更濃或更淡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "採取したカラーを濃くするか控えめにします。"
          }
        }
      }
    },
    "Makes the selected color family lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色族更亮或更暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使所選顏色族更亮或更暗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色系統を明るくするか暗くします。"
          }
        }
      }
    },
    "Makes the selected color family stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色族更浓或更淡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使所選顏色族更濃或更淡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色系統を濃くするか控えめにします。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使晕影更圆或更方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使暈影更圓或更方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビネットをより丸くするか、より四角くします。"
          }
        }
      }
    },
