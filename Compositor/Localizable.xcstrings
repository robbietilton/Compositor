      }
    },
    "The characters to draw with, in any order: each spot gets the one whose ink best matches its tone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The characters to draw with, in any order: each spot gets the one whose ink best matches its tone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于绘画的字符，顺序不限：各位置会使用墨色最接近其色调的字符"
