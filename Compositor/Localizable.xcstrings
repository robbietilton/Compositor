    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道（0–255）与点按颜色相差多少仍可被选中"
          }
        }
      }
    },
    "How far the blur softens, in pixels": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊柔化的范围（像素）"
