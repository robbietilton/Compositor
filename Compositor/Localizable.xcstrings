    },
    "The 2012 response. Calibration reaches most of the strength used by Version 6.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 2012 response. Calibration reaches most of the strength used by Version 6."
