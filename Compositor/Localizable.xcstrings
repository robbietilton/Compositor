    "Resizes layer pixels and applies existing transforms. Undo restores the originals.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图层像素大小并应用现有变换。撤销会恢复原来的像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整圖層像素大小並應用現有變換。還原會恢復原來的像素。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーのピクセルサイズを変え、既存の変形を適用します。取り消しで元に戻ります。"
          }
        }
      }
    },
