          }
        }
      }
    },
    "Add layer mask revealing the selection (Option-click to hide it)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加显示选区的图层蒙版（按住 Option 单击则隐藏选区）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增顯示選區的圖層遮色片（按住 Option 單擊則隱藏選區）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲を表示するレイヤーマスクを追加（Option キーを押しながらクリックで隠す）"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调最明显。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入膠片顆粒，中間調最明顯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルム粒子を加えます。中間調で最も強くなります。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的影调添加绿色或洋红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為最暗的影調加入綠色或洋紅色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も暗いトーンにグリーンかマゼンタを加えます。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿较大的形状增加或柔化对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿較大的形狀增加或柔化對比度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな形に沿ってコントラストを強めるか、柔らかくします。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加或柔化细小细节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加或柔化細小細節。"
          }
        },
