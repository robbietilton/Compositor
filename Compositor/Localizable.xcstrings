    "No layers yet": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無圖層"
          }
        }
      }
    },
    "No lens metadata on this layer. Profile sliders set generic correction strength.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖層沒有鏡頭詮釋資料。描述檔滑桿可設定一般校正強度。"
