    },
    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该选区过于复杂，无法生成轮廓。请尝试调整容差，或启用“连续”。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %@ megapixels.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
