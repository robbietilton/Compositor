      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 可加入，或按住 Option 針對單一外框減去"
          }
        }
      }
    },
    "How far a color may be from the picked ones and still be selected": {
      "localizations": {
