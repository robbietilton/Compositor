      }
    },
    "The Photoshop stroke isn’t supported on shape layers and was omitted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状图层不支持此 Photoshop 描边，已将其省略。"
          }
