    },
    "Highlight Priority": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高光優先"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト優先"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先保护亮边。颜色优先还会降低颜色。绘画叠加均匀覆盖边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高光優先保護亮邊。顏色優先還會降低顏色。繪畫疊加均勻覆蓋邊緣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト優先は明るい縁を保護します。カラー優先は色も減らします。ペイントオーバーレイは縁を均一に覆います。"
          }
        }
      }
    },
    "Highlights": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高光"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト"
          }
        }
      }
    },
    "Histogram": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直方图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直方圖"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒストグラム"
          }
        }
      }
    },
    "Hold Shift to add or Option to subtract for one outline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 添加，或按住 Option 减去，只针对一条轮廓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 加入，或按住 Option 減去，只針對一條輪廓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift を押したまま加えるか、Option を押したまま 1 つの輪郭から引く"
          }
        }
      }
    },
    "Horizontal": {
      "localizations": {
