            "state": "translated",
            "value": "2012 年的响应方式。校准强度已接近版本 6。"
          }
        }
      }
    },
    "The Camera Raw operation is unavailable or unsupported. Its source pixels have been preserved, but the adjusted image cannot be rendered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Camera Raw operation is unavailable or unsupported. Its source pixels have been preserved, but the adjusted image cannot be rendered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Raw 操作不可用或不受支持。源像素已保留，但无法渲染调整后的图像。"
          }
        }
      }
    },
    "The Photoshop file could not be read. It may be damaged or incomplete.": {
      "extractionState": "manual",
      "localizations": {
