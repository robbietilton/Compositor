          }
        }
      }
    },
    "Smooth the detected object outline; turn off for the raw pixel mask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑检测到的对象轮廓；关闭则使用原始像素蒙版"
