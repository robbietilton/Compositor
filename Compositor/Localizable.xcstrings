    "Horizontal ruler": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平标尺"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水平標尺"
