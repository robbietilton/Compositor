          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift キーを押しながらクリックでカラーを追加、Option キーを押しながらクリックで除外。"
          }
        }
      }
    },
    "Shifts how blue is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变蓝色的解释方式。"
          }
