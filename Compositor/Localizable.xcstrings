            "state": "translated",
            "value": "改變藍色的解釋方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブルーの解釈をずらします。"
          }
        }
      }
    },
    "Shifts how green is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变绿色的解释方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變綠色的解釋方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリーンの解釈をずらします。"
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变红色的解释方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變紅色的解釋方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レッドの解釈をずらします。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将发光从冷色移向暖色。光晕保持红色。提高发光之前没有效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將發光從冷色移向暖色。光暈保持紅色。提高發光之前沒有效果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローを寒色から暖色へずらします。ハレーションは赤のままです。グローを上げるまでは効果がありません。"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使拾取的颜色沿色轮移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使拾取的顏色沿色輪移動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "採取したカラーをカラーホイール上で動かします。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片从蓝色移向黄色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將照片從藍色移向黃色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をブルーからイエローへずらします。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片从绿色移向洋红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將照片從綠色移向洋紅色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をグリーンからモーブへずらします。"
          }
        }
      }
    },
    "Shifts the selected color family around the wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色族沿色轮移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使所選顏色族沿色輪移動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色系統をホイール上で動かします。"
          }
        }
      }
    },
    "Shifts the wheels toward shadows or highlights.": {
      "localizations": {
        "zh-Hans": {
