    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让源点在笔触之间随画笔移动；关闭则每笔都从源点开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓源點在筆觸之間隨畫筆移動；關閉則每筆都從源點開始"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストロークの間、ソースをブラシと一緒に動かす。オフにすると、毎ストロークがソース点から始まる"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在平滑明亮度之后保留局部对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在平滑明亮度之後保留區域性對比度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝度を滑らかにしたあとも、局所的なコントラストを残します。"
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此点固定。图稿不会缩放；被裁掉的内容仍留在画布之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此點固定。圖稿不會縮放；被裁掉的內容仍留在畫布之外。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この点を固定します。アートワークは拡大縮小せず、切り取った内容はカンバスの外に残ります。"
          }
        }
      }
    },
