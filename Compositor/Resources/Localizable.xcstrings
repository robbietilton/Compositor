      }
    },
    "Clear the haze that leaves background showing through thin areas" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear the haze that leaves background showing through thin areas" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Убрать дымку, из-за которой фон виден в тонких областях" } }
      }
    },
    "Option temporarily selects the eyedropper in painting tools. Shift constrains shapes/movement or adds to a selection; Option subtracts from selections or draws from center. Command-drag moves selected pixels; Command-Option-drag copies them. Option-drag duplicates layers/folders/effects; Option-click at a layer boundary toggles clipping. Command-click a thumbnail loads its selection. Control bypasses snapping. Right-drag adjusts brush size. Modifier-and-mouse gestures are fixed." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Option temporarily selects the eyedropper in painting tools. Shift constrains shapes/movement or adds to a selection; Option subtracts from selections or draws from center. Command-drag moves selected pixels; Command-Option-drag copies them. Option-drag duplicates layers/folders/effects; Option-click at a layer boundary toggles clipping. Command-click a thumbnail loads its selection. Control bypasses snapping. Right-drag adjusts brush size. Modifier-and-mouse gestures are fixed." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Option временно включает пипетку в инструментах рисования. Shift ограничивает фигуры/перемещение или добавляет к выделению; Option вычитает из выделения или рисует из центра. Command-перетаскивание перемещает выбранные пиксели; Command-Option-перетаскивание копирует их. Option-перетаскивание дублирует слои/группы/эффекты; Option-щелчок на границе слоя переключает обтравку. Command-щелчок по миниатюре загружает ее выделение. Control отключает привязку. Перетаскивание вправо меняет размер кисти. Жесты с модификаторами фиксированы." } }
      }
    },
    "Press 1–9 for 10–90%, 0 for 100%" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Press 1–9 for 10–90%, 0 for 100%" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нажмите 1–9 для 10–90%, 0 для 100%" } }
      }
    },
    "Show the transform box and handles (⌘H). When hidden, drag anywhere to move the layer." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Show the transform box and handles (⌘H). When hidden, drag anywhere to move the layer." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показать рамку трансформирования и маркеры (⌘H). Когда они скрыты, перетаскивайте слой в любом месте." } }
      }
    },
    "· encoded preview, fitted to window" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "· encoded preview, fitted to window" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "· закодированный предпросмотр, вписанный в окно" } }
      }
    },
