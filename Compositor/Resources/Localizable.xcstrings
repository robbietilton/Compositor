    "error.import.unreadable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The image could not be read. It may be damaged or unavailable." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось прочитать изображение. Возможно, оно повреждено или недоступно." } }
      }
    },
    "error.import.unsupported" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a JPEG, PNG, HEIC, or TIFF image." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите изображение JPEG, PNG, HEIC или TIFF." } }
      }
    },
    "error.import.tooLarge" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This import exceeds the current 100-megapixel document budget or 30,000-pixel side limit." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импорт превышает текущий лимит документа в 100 мегапикселей или 30 000 пикселей по стороне." } }
      }
    },
    "error.export.tooLarge" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Image export supports canvases up to 100 megapixels and 30,000 pixels per side." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Экспорт поддерживает холсты до 100 мегапикселей и 30 000 пикселей по стороне." } }
      }
    },
    "error.export.render" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The canvas could not be rendered. Try a smaller canvas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось отрисовать холст. Попробуйте холст меньшего размера." } }
      }
    },
    "error.export.encode" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The image could not be encoded." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось закодировать изображение." } }
      }
    },
    "error.project.invalid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is not a valid Compositor project, or its metadata is damaged." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это недопустимый проект Compositor или его метаданные повреждены." } }
      }
    },
    "error.project.version" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This project uses format version %d. This app supports versions 1–8." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Этот проект использует формат версии %d. Приложение поддерживает версии 1–8." } }
      }
    },
    "error.project.missingImage" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "An image inside the project is missing or damaged. The current document has not been replaced." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Изображение внутри проекта отсутствует или повреждено. Текущий документ не заменен." } }
      }
    },
    "error.project.tooLarge" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This project exceeds the supported canvas, layer, file-size, or 100-megapixel image limit." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проект превышает поддерживаемый лимит холста, слоев, размера файла или изображения в 100 мегапикселей." } }
      }
    },
    "error.project.encode" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "An image could not be saved. The previous project has not been replaced." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось сохранить изображение. Предыдущий проект не заменен." } }
      }
    },
    "error.wand.tooDetailed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это выделение слишком детализировано для построения контура. Измените допуск или включите режим «Смежные»." } }
      }
    },
    "error.wand.memory" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "There isn’t enough memory to make that selection." } },
