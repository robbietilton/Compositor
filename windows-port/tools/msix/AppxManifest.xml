<?xml version="1.0" encoding="utf-8"?>
<!--
  The package identity. `Publisher` must match the signing certificate's subject exactly, which is why
  tools/package-msix.ps1 creates the self-signed certificate with the same name.

  A .comp project is a directory, and Windows file associations only fire for files, so the type is
  registered by tools/register-filetype.ps1 instead of here.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Compositor.Windows"
    Publisher="CN=Compositor Dev"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Compositor</DisplayName>
    <PublisherDisplayName>Compositor Dev</PublisherDisplayName>
    <Description>An image compositor for Windows, compatible with Compositor projects from macOS.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Compositor" Executable="comp-gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Compositor"
        Description="An image compositor for Windows."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop application needs the full-trust capability to run at all. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
